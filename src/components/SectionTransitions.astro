<script>
  const initializeSectionTransitions = () => {
  if (document.documentElement.dataset.sectionTransitions === "ready") return;
  document.documentElement.dataset.sectionTransitions = "ready";
  const observed = new Map<Element, number>();
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const setMotionState = (element: HTMLElement, visible: boolean) => {
    const state = visible ? "visible" : "hidden";
    element.querySelectorAll<HTMLElement>("[data-motion-item]").forEach((item, index) => {
      item.dataset.motionState = state;
      item.style.setProperty("--motion-index", String(index));
    });
  };

  const setPresence = (element: HTMLElement, visible: boolean) => {
    const state = visible ? "visible" : "hidden";
    element.dataset.revealState = state;
    setMotionState(element, visible);
    window.dispatchEvent(new CustomEvent("homepage:section-presence", {
      detail: {
        id: element.id || element.dataset.reveal || "section",
        visible,
      },
    }));
  };

  const revealImmediately = () => {
    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => {
      const timer = observed.get(element);
      if (timer) window.clearTimeout(timer);
      setPresence(element, true);
    });
  };

  if (reduceMotion.matches || !("IntersectionObserver" in window)) {
    revealImmediately();
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const element = entry.target as HTMLElement;
        const pendingTimer = observed.get(element);
        if (pendingTimer) window.clearTimeout(pendingTimer);

        if (entry.isIntersecting) {
          observed.delete(element);
          setPresence(element, true);
          return;
        }

        const timer = window.setTimeout(() => {
          observed.delete(element);
          setPresence(element, false);
        }, 420);
        observed.set(element, timer);
      });
    }, {
      threshold: 0.12,
      rootMargin: "-8% 0px -14% 0px",
    });

    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => {
      const rect = element.getBoundingClientRect();
      const visible = rect.bottom > window.innerHeight * 0.08
        && rect.top < window.innerHeight * 0.86;
      setPresence(element, visible);
      observer.observe(element);
    });
    document.documentElement.classList.add("reveal-ready");

    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) {
        observer.disconnect();
        document.documentElement.classList.remove("reveal-ready");
        revealImmediately();
      }
    }, { once: true });
  }

  };

  const startSectionTransitions = () => window.requestAnimationFrame(initializeSectionTransitions);
  if (document.documentElement.dataset.experience === "ready") startSectionTransitions();
  else window.addEventListener("homepage:experience-ready", startSectionTransitions, { once: true });
</script>
