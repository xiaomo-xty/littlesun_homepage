---
import { articles } from "../data/articles";
---

<section id="articles" class="shell articles-section">
  <h2>代表文章</h2>
  <p>只展示 3-5 篇来自真实项目、调试、性能分析和架构决策的文章。</p>

  <div class="article-list">
    {articles.map((article) => (
      <article>
        <div class="article-copy">
          <h3>[文章占位] {article.title}</h3>
          <p>{article.topic}</p>
          <span>{article.description}</span>
        </div>
        <div class="article-thumbnail" aria-label="文章配图待补充">
          <span class="pixel-corner corner-nw" aria-hidden="true"></span>
          <span class="pixel-corner corner-ne" aria-hidden="true"></span>
          <span class="pixel-corner corner-sw" aria-hidden="true"></span>
          <span class="pixel-corner corner-se" aria-hidden="true"></span>
        </div>
      </article>
    ))}
  </div>
</section>

