<div class="experience-gate" data-experience-gate role="status" aria-live="polite">
  <div class="experience-loader">
    <div class="loader-current" aria-hidden="true">
      <span class="loader-pixel loader-pixel-one"></span>
      <span class="loader-pixel loader-pixel-two"></span>
      <span class="loader-pixel loader-pixel-three"></span>
      <span class="loader-jelly">
        <i class="loader-jelly-bell"></i>
        <i class="loader-jelly-thread loader-jelly-thread-one"></i>
        <i class="loader-jelly-thread loader-jelly-thread-two"></i>
        <i class="loader-jelly-thread loader-jelly-thread-three"></i>
      </span>
    </div>
    <p>正在唤醒太空海洋</p>
    <span class="loader-tide" aria-hidden="true"><i></i></span>
  </div>
</div>

<div class="reveal-choreography" data-reveal-choreography aria-hidden="true">
  <div class="reveal-jelly" data-reveal-jelly>
    <span class="reveal-jelly-halo"></span>
    <span class="reveal-jelly-bell"><i></i></span>
    <span class="reveal-tow-thread reveal-tow-thread-one" data-tow-thread></span>
    <span class="reveal-tow-thread reveal-tow-thread-two" data-tow-thread></span>
    <span class="reveal-tow-thread reveal-tow-thread-three" data-tow-thread></span>
    <span class="reveal-tow-thread reveal-tow-thread-four" data-tow-thread></span>
    <span class="reveal-pixel reveal-pixel-one"></span>
    <span class="reveal-pixel reveal-pixel-two"></span>
    <span class="reveal-pixel reveal-pixel-three"></span>
  </div>
  <div class="reveal-current" data-reveal-current>
    <span></span><span></span><span></span>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const gate = document.querySelector("[data-experience-gate]");
    const content = document.querySelector("[data-site-content]");
    const choreography = document.querySelector("[data-reveal-choreography]");
    if (!(gate instanceof HTMLElement) || !(content instanceof HTMLElement)) return;
    const siteHeader = content.querySelector(".site-header");
    const heroSection = content.querySelector(".hero-section");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const startedAt = performance.now();
    const minimumWait = reducedMotion ? 120 : 820;
    let started = false;

    const wait = (duration) => new Promise((resolve) => window.setTimeout(resolve, duration));
    const nextFrames = (count = 2) => new Promise((resolve) => {
      const step = () => {
        if (count <= 0) {
          resolve();
          return;
        }
        count -= 1;
        window.requestAnimationFrame(step);
      };
      window.requestAnimationFrame(step);
    });
    const finished = (animation) => animation.finished.catch(() => undefined);
    const clearContentEntranceStyles = () => {
      [content, siteHeader, heroSection].forEach((element) => {
        if (!(element instanceof HTMLElement)) return;
        element.style.removeProperty("opacity");
        element.style.removeProperty("transform");
        element.style.removeProperty("clip-path");
        element.style.removeProperty("-webkit-clip-path");
        element.style.removeProperty("will-change");
      });
      delete root.dataset.entryCull;
    };

    content.setAttribute("inert", "");

    const runReducedReveal = async () => {
      const choreographyStartedAt = performance.now();
      root.dataset.experience = "ambient";
      root.dataset.choreography = "reduced";
      root.dataset.choreographyPhase = "fade";
      gate.setAttribute("aria-hidden", "true");
      await nextFrames();
      content.removeAttribute("inert");
      root.dataset.experience = "entering";
      const animation = content.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: 220, easing: "ease-out", fill: "both" },
      );
      await finished(animation);
      root.dataset.experience = "ready";
      root.dataset.choreographyPhase = "complete";
      root.dataset.choreographyDurationMs = String(Math.round(performance.now() - choreographyStartedAt));
      animation.cancel();
      gate.hidden = true;
      window.dispatchEvent(new CustomEvent("homepage:experience-ready"));
    };

    const runJellyTowReveal = async (fast) => {
      const choreographyStartedAt = performance.now();
      const jelly = choreography?.querySelector("[data-reveal-jelly]");
      const current = choreography?.querySelector("[data-reveal-current]");
      const bell = choreography?.querySelector(".reveal-jelly-bell");
      const halo = choreography?.querySelector(".reveal-jelly-halo");
      const threads = choreography
        ? Array.from(choreography.querySelectorAll("[data-tow-thread]"))
        : [];
      const trackedAnimations = [];
      const play = (target, keyframes, options) => {
        const animation = target.animate(keyframes, options);
        trackedAnimations.push(animation);
        return animation;
      };
      const playTogether = (animations) => Promise.all(animations.map(finished));
      const pageStartY = 96;
      const jellyStartY = 68;
      const jellyChargeY = 71.5;
      const jellyFinishY = -28;
      const impulseDuration = fast ? 170 : 420;
      const towDuration = fast ? 620 : 1850;
      const continuousTowDuration = impulseDuration + towDuration;
      const impulseOffset = impulseDuration / continuousTowDuration;
      const towMotionEasing = "cubic-bezier(0.12, 0, 0.88, 1)";

      root.dataset.experience = "ambient";
      root.dataset.choreography = "active";
      gate.setAttribute("aria-hidden", "true");
      await nextFrames();
      await wait(fast ? 80 : 480);

      root.dataset.choreographyPhase = "arrival";
      if (jelly instanceof HTMLElement) {
        const arrival = play(
          jelly,
          [
            { opacity: 0, transform: "translate3d(0, 112vh, 0) scale(0.84, 1.08)" },
            { opacity: 1, transform: `translate3d(-0.5vw, ${jellyStartY + 1.5}vh, 0) scale(1.03, 0.97)`, offset: 0.82 },
            { opacity: 1, transform: `translate3d(0, ${jellyStartY}vh, 0) scale(1)` },
          ],
          { duration: fast ? 320 : 880, easing: "cubic-bezier(0.24, 0.7, 0.22, 1)", fill: "both" },
        );
        await finished(arrival);
      }

      root.dataset.choreographyPhase = "tension";
      const tensionAnimations = threads.map((thread, index) => play(
        thread,
        [
          { opacity: 0.34, transform: `rotate(${index % 2 === 0 ? -5 : 6}deg) scaleY(0.68)` },
          { opacity: 0.9, transform: `rotate(${index % 2 === 0 ? 2 : -3}deg) scaleY(1.08)`, offset: 0.72 },
          { opacity: 0.86, transform: "rotate(0deg) scaleY(1)" },
        ],
        { duration: fast ? 160 : 520, delay: index * 28, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
      ));
      if (current instanceof HTMLElement) {
        tensionAnimations.push(play(
          current,
          [
            { opacity: 0, transform: "translate3d(0, 100vh, 0)" },
            { opacity: 0.82, transform: `translate3d(0, ${pageStartY}vh, 0)` },
          ],
          { duration: fast ? 200 : 560, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
      }
      await playTogether(tensionAnimations);

      root.dataset.choreographyPhase = "charge";
      const chargeDuration = fast ? 190 : 640;
      const chargeAnimations = [];
      if (jelly instanceof HTMLElement) {
        chargeAnimations.push(play(
          jelly,
          [
            { opacity: 1, transform: `translate3d(0, ${jellyStartY}vh, 0) rotate(0deg) scale(1)` },
            { opacity: 1, transform: `translate3d(-0.4vw, ${jellyChargeY - 0.8}vh, 0) rotate(-0.8deg) scale(1.015, 0.985)`, offset: 0.58 },
            { opacity: 1, transform: `translate3d(-0.6vw, ${jellyChargeY}vh, 0) rotate(-1.2deg) scale(1.025, 0.97)` },
          ],
          { duration: chargeDuration, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
      }
      if (bell instanceof HTMLElement) {
        chargeAnimations.push(play(
          bell,
          [
            { opacity: 0.88, transform: "scale(1)" },
            { opacity: 1, transform: "scale(1.08, 0.86)", offset: 0.62 },
            { opacity: 1, transform: "scale(1.13, 0.78)" },
          ],
          { duration: chargeDuration, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
      }
      if (halo instanceof HTMLElement) {
        chargeAnimations.push(play(
          halo,
          [
            { opacity: 0.52, transform: "scale(1)" },
            { opacity: 0.72, transform: "scale(0.92)", offset: 0.6 },
            { opacity: 0.96, transform: "scale(0.82)" },
          ],
          { duration: chargeDuration, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
      }
      threads.forEach((thread, index) => {
        chargeAnimations.push(play(
          thread,
          [
            { opacity: 0.86, transform: "rotate(0deg) scaleY(1)" },
            { opacity: 1, transform: `rotate(${index % 2 === 0 ? 5.5 : -5}deg) scaleY(${0.82 - index * 0.018})`, offset: 0.72 },
            { opacity: 1, transform: `rotate(${index % 2 === 0 ? 7 : -6.5}deg) scaleY(${0.76 - index * 0.015})` },
          ],
          { duration: chargeDuration, delay: index * 20, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
      });
      if (current instanceof HTMLElement) {
        chargeAnimations.push(play(
          current,
          [
            { opacity: 0.82, transform: `translate3d(0, ${pageStartY}vh, 0) scaleY(1)` },
            { opacity: 0.9, transform: `translate3d(0, ${pageStartY}vh, 0) scaleY(0.94)` },
          ],
          { duration: chargeDuration, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
      }
      await playTogether(chargeAnimations);

      const scrollOffset = Math.max(0, window.scrollY);
      const clipPath = `inset(${scrollOffset}px 0 0 0)`;
      const topEntryTargets = [siteHeader, heroSection].filter(
        (element) => element instanceof HTMLElement,
      );
      const useViewportEntryTargets = scrollOffset < 1
        && window.matchMedia("(max-width: 767px)").matches
        && topEntryTargets.length > 0;
      const entranceTargets = useViewportEntryTargets
        ? topEntryTargets
        : [content];
      if (useViewportEntryTargets) root.dataset.entryCull = "hero";
      content.style.opacity = "1";
      if (entranceTargets[0] === content) {
        content.style.clipPath = clipPath;
        content.style.webkitClipPath = clipPath;
      }
      entranceTargets.forEach((target) => {
        target.style.transform = `translate3d(0, ${pageStartY}vh, 0)`;
        target.style.willChange = "transform";
      });

      root.dataset.experience = "entering";
      await nextFrames();

      // A single position curve avoids a perceptible acceleration join mid-tow.
      root.dataset.choreographyPhase = "impulse";
      const continuousTowAnimations = entranceTargets.map((target) => play(
        target,
        [
          { transform: `translate3d(0, ${pageStartY}vh, 0)` },
          { transform: "translate3d(0, 0, 0)" },
        ],
        { duration: continuousTowDuration, easing: towMotionEasing, fill: "both" },
      ));
      if (current instanceof HTMLElement) {
        continuousTowAnimations.push(play(
          current,
          [
            { opacity: 0.9, transform: `translate3d(0, ${pageStartY}vh, 0) scaleY(0.94)` },
            { opacity: 0.66, transform: "translate3d(0, 0, 0)" },
          ],
          { duration: continuousTowDuration, easing: towMotionEasing, fill: "both" },
        ));
      }
      if (jelly instanceof HTMLElement) {
        continuousTowAnimations.push(play(
          jelly,
          [
            { opacity: 1, transform: `translate3d(-0.6vw, ${jellyChargeY}vh, 0) rotate(-1.2deg) scale(1.025, 0.97)` },
            { opacity: 0.96, transform: `translate3d(0.8vw, ${jellyFinishY}vh, 0) rotate(1.5deg) scale(0.92, 1.02)` },
          ],
          { duration: continuousTowDuration, easing: towMotionEasing, fill: "both" },
        ));
      }
      if (bell instanceof HTMLElement) {
        continuousTowAnimations.push(play(
          bell,
          [
            { opacity: 1, transform: "scale(1.13, 0.78)", easing: "cubic-bezier(0.2, 0, 0.24, 1)" },
            { opacity: 1, transform: "scale(0.9, 1.14)", offset: impulseOffset * 0.44, easing: "cubic-bezier(0.4, 0, 0.3, 1)" },
            { opacity: 0.92, transform: "scale(1)", offset: impulseOffset, easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.88, transform: "scale(0.98, 1.02)", offset: impulseOffset + ((1 - impulseOffset) * 0.52), easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.84, transform: "scale(1)" },
          ],
          { duration: continuousTowDuration, fill: "both" },
        ));
      }
      if (halo instanceof HTMLElement) {
        continuousTowAnimations.push(play(
          halo,
          [
            { opacity: 0.96, transform: "scale(0.82)", easing: "cubic-bezier(0.2, 0, 0.24, 1)" },
            { opacity: 1, transform: "scale(1.28)", offset: impulseOffset * 0.48, easing: "cubic-bezier(0.4, 0, 0.3, 1)" },
            { opacity: 0.68, transform: "scale(1.08)", offset: impulseOffset, easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.34, transform: "scale(1.02)" },
          ],
          { duration: continuousTowDuration, fill: "both" },
        ));
      }
      threads.forEach((thread, index) => {
        continuousTowAnimations.push(play(
          thread,
          [
            { opacity: 1, transform: `rotate(${index % 2 === 0 ? 7 : -6.5}deg) scaleY(${0.76 - index * 0.015})`, easing: "cubic-bezier(0.2, 0, 0.24, 1)" },
            { opacity: 0.98, transform: `rotate(${index % 2 === 0 ? -4 : 4.5}deg) scaleY(1.12)`, offset: impulseOffset * (0.5 + (index * 0.025)), easing: "cubic-bezier(0.4, 0, 0.3, 1)" },
            { opacity: 0.92, transform: `rotate(${index % 2 === 0 ? -1 : 1}deg) scaleY(1.02)`, offset: impulseOffset, easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.94, transform: `rotate(${index % 2 === 0 ? -1.4 : 1.2}deg) scaleY(1.035)`, offset: impulseOffset + ((1 - impulseOffset) * 0.46), easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.78, transform: "rotate(0deg) scaleY(1)" },
          ],
          { duration: continuousTowDuration, fill: "both" },
        ));
      });
      const towPhaseTimer = window.setTimeout(() => {
        if (root.dataset.choreography === "active") root.dataset.choreographyPhase = "tow";
      }, impulseDuration);
      await playTogether(continuousTowAnimations);
      window.clearTimeout(towPhaseTimer);

      root.dataset.choreographyPhase = "release";
      if (current instanceof HTMLElement) {
        await finished(play(
          current,
          [
            { opacity: 0.66, transform: "translate3d(0, 0, 0)" },
            { opacity: 0, transform: "translate3d(0, -7vh, 0)" },
          ],
          { duration: fast ? 160 : 360, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "both" },
        ));
      }

      root.dataset.experience = "ready";
      root.dataset.choreography = "complete";
      root.dataset.choreographyPhase = "complete";
      root.dataset.choreographyDurationMs = String(Math.round(performance.now() - choreographyStartedAt));
      content.removeAttribute("inert");
      clearContentEntranceStyles();
      trackedAnimations.forEach((animation) => animation.cancel());
      gate.hidden = true;
      window.dispatchEvent(new CustomEvent("homepage:experience-ready"));
    };

    const startReveal = async (fast = false) => {
      if (started) return;
      started = true;
      if (fast) root.dataset.ambientFallback = "true";
      const remainingWait = Math.max(0, minimumWait - (performance.now() - startedAt));
      await wait(remainingWait);

      if (reducedMotion) await runReducedReveal();
      else await runJellyTowReveal(fast);
    };

    // The static ocean is already in the SSR shell. WebGPU can take over independently.
    void startReveal();
  })();
</script>

<style is:global>
  .site-content { position: relative; z-index: 1; }

  .experience-gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    min-width: 320px;
    place-items: center;
    overflow: hidden;
    background: var(--page);
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 440ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 440ms;
  }

  html[data-experience="loading"],
  html[data-experience="ambient"],
  html[data-experience="entering"] { overflow: hidden; }

  html[data-experience="loading"] .experience-gate {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .experience-loader {
    display: grid;
    width: min(272px, calc(100vw - 48px));
    justify-items: center;
    gap: 20px;
  }

  .experience-loader p {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1.8;
    text-align: center;
  }

  .loader-current { position: relative; width: 156px; height: 92px; }

  .loader-jelly {
    position: absolute;
    top: 14px;
    left: 58px;
    width: 42px;
    height: 64px;
    animation: loader-jelly-glide 1.7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .loader-jelly-bell {
    position: absolute;
    top: 0;
    left: 4px;
    width: 34px;
    height: 26px;
    border: 2px solid var(--accent-strong);
    border-bottom-width: 1px;
    border-radius: 50% 50% 42% 42% / 72% 72% 28% 28%;
    background: color-mix(in srgb, var(--accent) 16%, var(--page));
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 8%, transparent);
    animation: loader-jelly-pulse 1.7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .loader-jelly-thread {
    position: absolute;
    top: 25px;
    width: 1px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-strong);
    transform-origin: top;
    animation: loader-thread 1.7s ease-in-out infinite;
  }

  .loader-jelly-thread-one { left: 11px; }
  .loader-jelly-thread-two { left: 21px; height: 36px; animation-delay: -140ms; }
  .loader-jelly-thread-three { left: 31px; animation-delay: -280ms; }

  .loader-pixel {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--accent);
    animation: loader-pixel-drift 2.2s ease-in-out infinite;
  }

  .loader-pixel-one { top: 20px; left: 16px; }
  .loader-pixel-two { top: 58px; right: 18px; width: 8px; height: 8px; animation-delay: -720ms; }
  .loader-pixel-three { right: 40px; bottom: 8px; width: 3px; height: 3px; animation-delay: -1.2s; }

  .loader-tide {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    background: var(--line);
  }

  .loader-tide i {
    position: absolute;
    inset: 0;
    background: var(--accent-strong);
    transform: translateX(-72%) scaleX(0.34);
    transform-origin: left;
    animation: loader-tide 1.35s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .reveal-choreography {
    position: fixed;
    inset: 0;
    z-index: 900;
    min-width: 320px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  html[data-choreography="active"] .reveal-choreography { opacity: 1; visibility: visible; }

  .reveal-jelly {
    position: absolute;
    top: 0;
    left: clamp(68%, 73vw, 78%);
    width: 82px;
    height: calc(56px + clamp(134px, 21vh, 188px));
    opacity: 0;
    transform: translate3d(0, 112vh, 0) scale(0.84, 1.08);
    transform-origin: 50% 18%;
  }

  .reveal-jelly-halo {
    position: absolute;
    top: -18px;
    left: -15px;
    width: 112px;
    height: 88px;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    border-radius: 50%;
    opacity: 0.56;
  }

  .reveal-jelly-bell {
    position: absolute;
    top: 0;
    left: 5px;
    width: 72px;
    height: 55px;
    overflow: hidden;
    border: 2px solid var(--accent-strong);
    border-bottom-width: 1px;
    border-radius: 52% 52% 38% 38% / 74% 74% 28% 28%;
    background: radial-gradient(circle at 36% 28%, rgb(255 255 255 / 0.74) 0 4%, transparent 5%), color-mix(in srgb, var(--accent) 24%, var(--page));
    box-shadow: inset 0 -10px 18px color-mix(in srgb, var(--accent-strong) 20%, transparent), 0 0 24px color-mix(in srgb, var(--accent) 28%, transparent);
    transform-origin: 50% 82%;
  }

  .reveal-jelly-bell i {
    position: absolute;
    right: 11px;
    bottom: 8px;
    left: 11px;
    height: 9px;
    border-top: 1px solid color-mix(in srgb, var(--accent-strong) 60%, transparent);
    border-radius: 50%;
  }

  .reveal-tow-thread {
    position: absolute;
    top: 49px;
    display: block;
    width: 20px;
    height: clamp(134px, 21vh, 188px);
    border-left: 2px solid color-mix(in srgb, var(--accent-strong) 78%, transparent);
    border-radius: 50%;
    transform-origin: top;
  }

  .reveal-tow-thread-one { left: 13px; transform: rotate(7deg); }
  .reveal-tow-thread-two { left: 31px; height: clamp(142px, 22vh, 196px); transform: rotate(-5deg); }
  .reveal-tow-thread-three { left: 49px; height: clamp(138px, 21.5vh, 192px); transform: rotate(6deg); }
  .reveal-tow-thread-four { left: 65px; height: clamp(128px, 20vh, 180px); transform: rotate(-8deg); }

  .reveal-pixel {
    position: absolute;
    display: block;
    width: 5px;
    height: 5px;
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 72%, transparent);
  }

  .reveal-pixel-one { top: 18px; left: -16px; }
  .reveal-pixel-two { top: 68px; right: -8px; width: 3px; height: 3px; }
  .reveal-pixel-three { right: 4px; bottom: 6px; width: 7px; height: 7px; }

  .reveal-current {
    position: absolute;
    top: 0;
    right: -12%;
    left: -12%;
    height: 46vh;
    opacity: 0;
    transform: translate3d(0, 100vh, 0);
    transform-origin: center top;
  }

  .reveal-current::before,
  .reveal-current::after,
  .reveal-current > span {
    position: absolute;
    right: 0;
    left: 0;
    height: 48%;
    border-top: 2px solid color-mix(in srgb, var(--accent) 68%, transparent);
    border-radius: 50%;
    content: "";
  }

  .reveal-current::before { top: 0; transform: rotate(-1.4deg); }
  .reveal-current::after { top: 18%; opacity: 0.44; transform: rotate(1.2deg) scaleX(0.94); }
  .reveal-current > span:nth-child(1) { top: 7%; opacity: 0.68; transform: rotate(0.4deg) scaleX(1.08); }
