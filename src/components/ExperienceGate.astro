<div class="experience-gate" data-experience-gate role="status" aria-live="polite">
  <div class="experience-loader">
    <div class="loader-current" aria-hidden="true">
      <span class="loader-pixel loader-pixel-one"></span>
      <span class="loader-pixel loader-pixel-two"></span>
      <span class="loader-pixel loader-pixel-three"></span>
      <span class="loader-jelly">
        <i class="loader-jelly-bell"></i>
        <i class="loader-jelly-thread loader-jelly-thread-one"></i>
        <i class="loader-jelly-thread loader-jelly-thread-two"></i>
        <i class="loader-jelly-thread loader-jelly-thread-three"></i>
      </span>
    </div>
    <p>正在唤醒太空海洋</p>
    <span class="loader-tide" aria-hidden="true"><i></i></span>
  </div>
</div>

<div class="reveal-choreography" data-reveal-choreography aria-hidden="true">
  <div class="reveal-jelly" data-reveal-jelly>
    <span class="reveal-jelly-halo"></span>
    <span class="reveal-jelly-bell"><i></i></span>
    <span class="reveal-tow-thread reveal-tow-thread-one" data-tow-thread></span>
    <span class="reveal-tow-thread reveal-tow-thread-two" data-tow-thread></span>
    <span class="reveal-tow-thread reveal-tow-thread-three" data-tow-thread></span>
    <span class="reveal-tow-thread reveal-tow-thread-four" data-tow-thread></span>
    <span class="reveal-pixel reveal-pixel-one"></span>
    <span class="reveal-pixel reveal-pixel-two"></span>
    <span class="reveal-pixel reveal-pixel-three"></span>
  </div>
  <div class="reveal-current" data-reveal-current>
    <span></span><span></span><span></span>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const gate = document.querySelector("[data-experience-gate]");
    const content = document.querySelector("[data-site-content]");
    const choreography = document.querySelector("[data-reveal-choreography]");
    if (!(gate instanceof HTMLElement) || !(content instanceof HTMLElement)) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const startedAt = performance.now();
    const minimumWait = reducedMotion ? 120 : 820;
    let started = false;
    let fallbackTimer = 0;

    const wait = (duration) => new Promise((resolve) => window.setTimeout(resolve, duration));
    const nextFrames = (count = 2) => new Promise((resolve) => {
      const step = () => {
        if (count <= 0) {
          resolve();
          return;
        }
        count -= 1;
        window.requestAnimationFrame(step);
      };
      window.requestAnimationFrame(step);
    });
    const finished = (animation) => animation.finished.catch(() => undefined);

    content.setAttribute("inert", "");

    const runReducedReveal = async () => {
      const choreographyStartedAt = performance.now();
      root.dataset.experience = "ambient";
      root.dataset.choreography = "reduced";
      root.dataset.choreographyPhase = "fade";
      gate.setAttribute("aria-hidden", "true");
      await nextFrames();
      content.removeAttribute("inert");
      root.dataset.experience = "entering";
      const animation = content.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: 220, easing: "ease-out", fill: "both" },
      );
      await finished(animation);
      root.dataset.experience = "ready";
      root.dataset.choreographyPhase = "complete";
      root.dataset.choreographyDurationMs = String(Math.round(performance.now() - choreographyStartedAt));
      animation.cancel();
      gate.hidden = true;
      window.dispatchEvent(new CustomEvent("homepage:experience-ready"));
    };

    const runJellyTowReveal = async (fast) => {
      const choreographyStartedAt = performance.now();
      const jelly = choreography?.querySelector("[data-reveal-jelly]");
      const current = choreography?.querySelector("[data-reveal-current]");
      const threads = choreography
        ? Array.from(choreography.querySelectorAll("[data-tow-thread]"))
        : [];
      const header = document.querySelector(".site-header");
      const heroCopy = document.querySelector(".hero-copy");
      const visualStage = document.querySelector("[data-hero-stage-entrance]");

      root.dataset.experience = "ambient";
      root.dataset.choreography = "active";
      gate.setAttribute("aria-hidden", "true");
      await nextFrames();
      await wait(fast ? 80 : 480);

      root.dataset.choreographyPhase = "arrival";
      if (jelly instanceof HTMLElement) {
        const arrival = jelly.animate(
          [
            { opacity: 0, transform: "translate3d(0, 34vh, 0) scale(0.82)" },
            { opacity: 1, transform: "translate3d(0, -2vh, 0) scale(1.03)", offset: 0.74 },
            { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)" },
          ],
          { duration: fast ? 360 : 820, easing: "cubic-bezier(0.33, 1, 0.68, 1)", fill: "both" },
        );
        await finished(arrival);
      }

      root.dataset.choreographyPhase = "tension";
      if (threads.length > 0) {
        const tensionAnimations = threads.map((thread, index) => thread.animate(
          [
            { transform: `rotate(${index % 2 === 0 ? -4 : 5}deg) scaleY(0.72)` },
            { transform: `rotate(${index % 2 === 0 ? 2 : -3}deg) scaleY(1.12)` },
            { transform: "rotate(0deg) scaleY(1)" },
          ],
          { duration: fast ? 180 : 460, delay: index * 34, easing: "cubic-bezier(0.45, 0, 0.55, 1)", fill: "both" },
        ));
        await Promise.all(tensionAnimations.map(finished));
      }

      const entranceTargets = [header, heroCopy, visualStage].filter((target) => target instanceof HTMLElement);
      entranceTargets.forEach((target, index) => {
        target.style.opacity = "0";
        target.style.transform = `translate3d(0, ${index === 0 ? 30 : index === 1 ? 112 : 148}px, 0)`;
      });

      content.removeAttribute("inert");
      root.dataset.experience = "entering";
      root.dataset.choreographyPhase = "tow";

      const animations = [];
      if (header instanceof HTMLElement) {
        animations.push(header.animate(
          [
            { opacity: 0, transform: "translate3d(0, 30px, 0)", easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.08, transform: "translate3d(0, 27px, 0)", offset: 0.22, easing: "cubic-bezier(0.22, 0.68, 0.24, 1)" },
            { opacity: 0.94, transform: "translate3d(0, 3px, 0)", offset: 0.76, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 1, transform: "translate3d(0, 0, 0)" },
          ],
          { duration: fast ? 420 : 2200, easing: "linear", fill: "both" },
        ));
      }
      if (heroCopy instanceof HTMLElement) {
        animations.push(heroCopy.animate(
          [
            { opacity: 0, transform: "translate3d(0, 112px, 0)", easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.08, transform: "translate3d(0, 106px, 0)", offset: 0.18, easing: "cubic-bezier(0.22, 0.68, 0.24, 1)" },
            { opacity: 0.72, transform: "translate3d(0, 42px, 0)", offset: 0.58, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 1, transform: "translate3d(0, -4px, 0)", offset: 0.88, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 1, transform: "translate3d(0, 0, 0)" },
          ],
          { duration: fast ? 620 : 2720, delay: fast ? 0 : 90, easing: "linear", fill: "both" },
        ));
      }
      if (visualStage instanceof HTMLElement) {
        animations.push(visualStage.animate(
          [
            { opacity: 0, transform: "translate3d(0, 148px, 0) rotate(1.4deg) scale(0.965)", easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.06, transform: "translate3d(0, 140px, 0) rotate(1.2deg) scale(0.97)", offset: 0.18, easing: "cubic-bezier(0.22, 0.68, 0.24, 1)" },
            { opacity: 0.7, transform: "translate3d(0, 54px, 0) rotate(0.35deg) scale(0.99)", offset: 0.58, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 1, transform: "translate3d(0, -4px, 0) rotate(-0.16deg) scale(1.003)", offset: 0.88, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 1, transform: "translate3d(0, 0, 0) rotate(0deg) scale(1)" },
          ],
          { duration: fast ? 680 : 2860, delay: fast ? 40 : 150, easing: "linear", fill: "both" },
        ));
      }
      if (current instanceof HTMLElement) {
        animations.push(current.animate(
          [
            { opacity: 0, transform: "translate3d(0, 30vh, 0) scaleY(0.82)", easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 0.24, transform: "translate3d(0, 22vh, 0) scaleY(0.9)", offset: 0.2, easing: "cubic-bezier(0.22, 0.68, 0.24, 1)" },
            { opacity: 0.78, transform: "translate3d(0, -6vh, 0) scaleY(1)", offset: 0.54, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 0.36, transform: "translate3d(0, -44vh, 0) scaleY(1.06)", offset: 0.82, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 0, transform: "translate3d(0, -76vh, 0) scaleY(0.96)" },
          ],
          { duration: fast ? 760 : 2880, easing: "linear", fill: "both" },
        ));
      }
      if (jelly instanceof HTMLElement) {
        animations.push(jelly.animate(
          [
            { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", easing: "cubic-bezier(0.45, 0, 0.55, 1)" },
            { opacity: 1, transform: "translate3d(-0.4vw, -4vh, 0) rotate(-1deg) scale(0.94, 1.04)", offset: 0.2, easing: "cubic-bezier(0.22, 0.68, 0.24, 1)" },
            { opacity: 1, transform: "translate3d(-1.2vw, -31vh, 0) rotate(-3deg) scale(0.98)", offset: 0.54, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 0.78, transform: "translate3d(0.6vw, -59vh, 0) rotate(2deg) scale(0.88)", offset: 0.82, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            { opacity: 0, transform: "translate3d(2vw, -82vh, 0) rotate(5deg) scale(0.72)", filter: "blur(2px)" },
          ],
          { duration: fast ? 780 : 2920, easing: "linear", fill: "both" },
        ));
      }

      await Promise.all(animations.map(finished));
      root.dataset.experience = "ready";
      root.dataset.choreography = "complete";
      root.dataset.choreographyPhase = "complete";
      root.dataset.choreographyDurationMs = String(Math.round(performance.now() - choreographyStartedAt));
      entranceTargets.forEach((target) => {
        target.style.removeProperty("opacity");
        target.style.removeProperty("transform");
      });
      animations.forEach((animation) => animation.cancel());
      gate.hidden = true;
      window.dispatchEvent(new CustomEvent("homepage:experience-ready"));
    };

    const startReveal = async (fast = false) => {
      if (started) return;
      started = true;
      window.clearTimeout(fallbackTimer);
      if (fast) root.dataset.ambientFallback = "true";
      const remainingWait = Math.max(0, minimumWait - (performance.now() - startedAt));
      await wait(remainingWait);

      if (reducedMotion) await runReducedReveal();
      else await runJellyTowReveal(fast);
    };

    window.addEventListener("homepage:ambient-ready", () => void startReveal(), { once: true });
    fallbackTimer = window.setTimeout(() => void startReveal(true), 4800);
    if (root.dataset.ambientReady === "true") void startReveal();
  })();
</script>

<style is:global>
  .site-content { position: relative; z-index: 1; }

  .experience-gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    min-width: 320px;
    place-items: center;
    overflow: hidden;
    background: var(--page);
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 440ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 440ms;
  }

  html[data-experience="loading"] { overflow: hidden; }

  html[data-experience="loading"] .experience-gate {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .experience-loader {
    display: grid;
    width: min(272px, calc(100vw - 48px));
    justify-items: center;
    gap: 20px;
  }

  .experience-loader p {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1.8;
    text-align: center;
  }

  .loader-current { position: relative; width: 156px; height: 92px; }

  .loader-jelly {
    position: absolute;
    top: 14px;
    left: 58px;
    width: 42px;
    height: 64px;
    animation: loader-jelly-glide 1.7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .loader-jelly-bell {
    position: absolute;
    top: 0;
    left: 4px;
    width: 34px;
    height: 26px;
    border: 2px solid var(--accent-strong);
    border-bottom-width: 1px;
    border-radius: 50% 50% 42% 42% / 72% 72% 28% 28%;
    background: color-mix(in srgb, var(--accent) 16%, var(--page));
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 8%, transparent);
    animation: loader-jelly-pulse 1.7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .loader-jelly-thread {
    position: absolute;
    top: 25px;
    width: 1px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-strong);
    transform-origin: top;
    animation: loader-thread 1.7s ease-in-out infinite;
  }

  .loader-jelly-thread-one { left: 11px; }
  .loader-jelly-thread-two { left: 21px; height: 36px; animation-delay: -140ms; }
  .loader-jelly-thread-three { left: 31px; animation-delay: -280ms; }

  .loader-pixel {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--accent);
    animation: loader-pixel-drift 2.2s ease-in-out infinite;
  }

  .loader-pixel-one { top: 20px; left: 16px; }
  .loader-pixel-two { top: 58px; right: 18px; width: 8px; height: 8px; animation-delay: -720ms; }
  .loader-pixel-three { right: 40px; bottom: 8px; width: 3px; height: 3px; animation-delay: -1.2s; }

  .loader-tide {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    background: var(--line);
  }

  .loader-tide i {
    position: absolute;
    inset: 0;
    background: var(--accent-strong);
    transform: translateX(-72%) scaleX(0.34);
    transform-origin: left;
    animation: loader-tide 1.35s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .reveal-choreography {
    position: fixed;
    inset: 0;
    z-index: 900;
    min-width: 320px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  html[data-choreography="active"] .reveal-choreography { opacity: 1; visibility: visible; }

  .reveal-jelly {
    position: absolute;
    top: 60%;
    left: clamp(68%, 73vw, 78%);
    width: 82px;
    height: 150px;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 42%, transparent));
    transform-origin: 50% 18%;
  }

  .reveal-jelly-halo {
    position: absolute;
    top: -18px;
    left: -15px;
    width: 112px;
    height: 88px;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    border-radius: 50%;
    opacity: 0.56;
  }

  .reveal-jelly-bell {
    position: absolute;
    top: 0;
    left: 5px;
    width: 72px;
    height: 55px;
    overflow: hidden;
    border: 2px solid var(--accent-strong);
    border-bottom-width: 1px;
    border-radius: 52% 52% 38% 38% / 74% 74% 28% 28%;
    background: radial-gradient(circle at 36% 28%, rgb(255 255 255 / 0.74) 0 4%, transparent 5%), color-mix(in srgb, var(--accent) 24%, var(--page));
    box-shadow: inset 0 -10px 18px color-mix(in srgb, var(--accent-strong) 20%, transparent), 0 0 24px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .reveal-jelly-bell i {
    position: absolute;
    right: 11px;
    bottom: 8px;
    left: 11px;
    height: 9px;
    border-top: 1px solid color-mix(in srgb, var(--accent-strong) 60%, transparent);
    border-radius: 50%;
  }

  .reveal-tow-thread {
    position: absolute;
    top: 49px;
    display: block;
    width: 20px;
    height: 86px;
    border-left: 2px solid color-mix(in srgb, var(--accent-strong) 78%, transparent);
    border-radius: 50%;
    transform-origin: top;
  }

  .reveal-tow-thread-one { left: 13px; transform: rotate(7deg); }
  .reveal-tow-thread-two { left: 31px; height: 96px; transform: rotate(-5deg); }
  .reveal-tow-thread-three { left: 49px; height: 92px; transform: rotate(6deg); }
  .reveal-tow-thread-four { left: 65px; height: 78px; transform: rotate(-8deg); }

  .reveal-pixel {
    position: absolute;
    display: block;
    width: 5px;
    height: 5px;
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 72%, transparent);
  }

  .reveal-pixel-one { top: 18px; left: -16px; }
  .reveal-pixel-two { top: 68px; right: -8px; width: 3px; height: 3px; }
  .reveal-pixel-three { right: 4px; bottom: 6px; width: 7px; height: 7px; }

  .reveal-current {
    position: absolute;
    top: 72%;
    right: -12%;
    left: -12%;
    height: 46vh;
    transform-origin: center top;
  }

  .reveal-current::before,
  .reveal-current::after,
  .reveal-current > span {
    position: absolute;
    right: 0;
    left: 0;
    height: 48%;
    border-top: 2px solid color-mix(in srgb, var(--accent) 68%, transparent);
    border-radius: 50%;
    content: "";
  }

  .reveal-current::before { top: 0; transform: rotate(-1.4deg); }
  .reveal-current::after { top: 18%; opacity: 0.44; transform: rotate(1.2deg) scaleX(0.94); }
  .reveal-current > span:nth-child(1) { top: 7%; opacity: 0.68; transform: rotate(0.4deg) scaleX(1.08); }
  .reveal-current > span:nth-child(2) { top: 27%; opacity: 0.28; transform: rotate(-2deg) scaleX(0.86); }
  .reveal-current > span:nth-child(3) { top: 38%; opacity: 0.2; transform: rotate(2.4deg) scaleX(1.12); }

  html[data-experience="loading"] .site-content,
  html[data-experience="ambient"] .site-content { opacity: 0; visibility: hidden; pointer-events: none; }

  html[data-experience="entering"] .site-content,
  html[data-experience="ready"] .site-content { opacity: 1; visibility: visible; pointer-events: auto; }

  @keyframes loader-jelly-glide {
    0%, 100% { transform: translate3d(-4px, 5px, 0); }
    24% { transform: translate3d(0, -5px, 0); }
    66% { transform: translate3d(5px, 1px, 0); }
  }

  @keyframes loader-jelly-pulse {
    0%, 100% { transform: scale(1, 1); filter: brightness(0.88); }
    18% { transform: scale(0.82, 1.14); filter: brightness(1.38); }
    42% { transform: scale(1.06, 0.94); filter: brightness(1.05); }
  }

  @keyframes loader-thread {
    0%, 100% { transform: rotate(5deg) scaleY(0.82); }
    30% { transform: rotate(-7deg) scaleY(1); }
    65% { transform: rotate(8deg) scaleY(0.92); }
  }

  @keyframes loader-pixel-drift {
    0%, 100% { opacity: 0.25; transform: translate3d(-3px, 4px, 0) scale(0.8); }
    50% { opacity: 0.9; transform: translate3d(5px, -5px, 0) scale(1.15); }
  }

  @keyframes loader-tide {
    0% { transform: translateX(-76%) scaleX(0.26); }
    48% { transform: translateX(18%) scaleX(0.62); }
    100% { transform: translateX(132%) scaleX(0.24); }
  }

  @media (max-width: 767px) {
    .reveal-jelly { top: 66%; left: 68%; width: 68px; transform: scale(0.84); }
    .reveal-current { right: -32%; left: -32%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-jelly,
    .loader-jelly-bell,
    .loader-jelly-thread,
    .loader-pixel,
    .loader-tide i { animation: none; }
    .reveal-choreography { display: none; }
  }
</style>
