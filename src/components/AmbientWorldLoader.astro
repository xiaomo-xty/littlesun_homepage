---
import AmbientWorld from "./AmbientWorld";
---

<div data-ambient-root><AmbientWorld /></div>

<script>
  import { shouldStartAmbientRuntime } from "../lib/ambientPolicy";

  const root = document.documentElement;
  const container = document.querySelector("[data-ambient-root]");
  const host = container?.querySelector(".ambient-world");

  if (container instanceof HTMLElement && host instanceof HTMLElement) {
    const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
    const connection = navigator as Navigator & { connection?: { saveData?: boolean } };
    const searchParams = new URLSearchParams(window.location.search);
    const requestedBackend = searchParams.get("ambient");
    const debugEnabled = searchParams.get("debug") === "1";
    let mounted = false;

    if (debugEnabled) {
      const panel = document.createElement("pre");
      panel.id = "ambient-runtime-debug";
      panel.setAttribute("role", "status");
      panel.setAttribute("aria-live", "polite");
      Object.assign(panel.style, {
        position: "fixed",
        top: "12px",
        left: "12px",
        zIndex: "2147483647",
        maxWidth: "calc(100vw - 24px)",
        margin: "0",
        padding: "10px 12px",
        border: "1px solid rgba(116, 203, 255, 0.72)",
        borderRadius: "4px",
        background: "rgba(5, 12, 18, 0.9)",
        color: "#d9f2ff",
        font: "12px/1.5 ui-monospace, SFMono-Regular, Consolas, monospace",
        whiteSpace: "pre-wrap",
        pointerEvents: "none",
      });
      document.body.append(panel);

      let lastError = "none";
      const updatePanel = () => {
        const currentHost = document.querySelector(".ambient-world");
        const dataset = currentHost instanceof HTMLElement ? currentHost.dataset : {};
        panel.textContent = [
          `requested: ${requestedBackend || "auto"}`,
          `status: ${dataset.status || "missing"}`,
          `backend: ${dataset.backend || "missing"}`,
          `runtime: ${dataset.runtime || "missing"}`,
          `motion: ${dataset.motion || "missing"}`,
          `simulation tick: ${dataset.simulationTick || "0"}`,
          `render fps: ${dataset.renderFps || "sampling"}`,
          `frame ms avg/max: ${dataset.frameTimeAverage || "-"} / ${dataset.frameTimeMax || "-"}`,
          `frames >20ms: ${dataset.framesOverBudget || "0"}`,
          `secure context: ${window.isSecureContext}`,
          `WebGPU exposed: ${"gpu" in navigator}`,
          `reduced motion: ${motionPreference.matches}`,
          `Save-Data: ${Boolean(connection.connection?.saveData)}`,
          `page visible: ${!document.hidden}`,
          `last error: ${lastError}`,
        ].join("\n");
      };

      window.addEventListener("homepage:ambient-diagnostic", (event) => {
        const detail = (event as CustomEvent<{ stage?: string; message?: string }>).detail;
        lastError = `${detail?.stage || "runtime"}: ${detail?.message || "unknown error"}`;
        updatePanel();
      });
      window.addEventListener("error", (event) => {
        lastError = `window: ${event.message || "unknown error"}`;
        updatePanel();
      });
      window.addEventListener("unhandledrejection", (event) => {
        lastError = `promise: ${event.reason instanceof Error ? event.reason.message : String(event.reason)}`;
        updatePanel();
      });
      window.setInterval(updatePanel, 250);
      updatePanel();
    }

    const signalStaticReady = (reason: string) => {
      host.dataset.status = "ready";
      host.dataset.backend = "static";
      host.dataset.quality = "static";
      host.dataset.runtime = reason;
      root.dataset.ambientBackend = "static";
      root.dataset.ambientReady = "true";
      window.dispatchEvent(new CustomEvent("homepage:ambient-ready", {
        detail: { backend: "static", reason },
      }));
    };

    const mountRuntime = async () => {
      if (mounted) return;
      mounted = true;
      host.dataset.status = "loading";
      host.dataset.backend = "static";
      delete root.dataset.ambientReady;

      try {
        const [{ createElement }, { hydrateRoot }, { default: Runtime }] = await Promise.all([
          import("react"),
          import("react-dom/client"),
          import("./AmbientWorld"),
        ]);
        hydrateRoot(container, createElement(Runtime));
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        console.warn("[ambient] Dynamic runtime unavailable; using the static ocean.", error);
        mounted = false;
        signalStaticReady("runtime-error");
        window.dispatchEvent(new CustomEvent("homepage:ambient-diagnostic", {
          detail: { stage: "module", message },
        }));
      }
    };

    const applyPolicy = () => {
      const saveData = Boolean(connection.connection?.saveData);
      const shouldStart = shouldStartAmbientRuntime({
        requestedBackend,
        reducedMotion: motionPreference.matches,
        saveData,
      });
      if (shouldStart) void mountRuntime();
      else if (!mounted) {
        const reason = requestedBackend === "static"
          ? "explicit-static"
          : motionPreference.matches
            ? "reduced-motion"
            : saveData
              ? "save-data"
              : "static-policy";
        signalStaticReady(reason);
      }
    };

    motionPreference.addEventListener("change", applyPolicy);
    applyPolicy();
  }
</script>
