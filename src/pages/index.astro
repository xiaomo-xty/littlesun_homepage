---
import BaseLayout from "../layouts/BaseLayout.astro";
import { articles } from "../data/articles";
import { projects } from "../data/projects";
import { primaryLinks, site } from "../data/site";
---

<BaseLayout>
  <header class="site-header">
    <nav class="shell nav" aria-label="主导航">
      <a class="identity" href="#top">{site.title}</a>
      <div class="nav-links">
        <a href="#about">关于</a>
        <a href="#projects">项目</a>
        <a href="#articles">文章</a>
        <a href="#life">生活</a>
      </div>
      <span class="pixel-type">LIGHT / DARK</span>
    </nav>
  </header>

  <main id="main-content">
    <section id="top" class="shell hero">
      <div>
        <p class="direction">{site.direction.join(" / ")}</p>
        <h1>{site.title}</h1>
        <p class="intro">{site.introduction}</p>
        <div class="actions">
          <a class="button primary" href="#projects">看项目</a>
          <a class="button secondary" href="#contact">联系我</a>
        </div>
        <div class="quick-links">
          {primaryLinks.map((link) =>
            link.href ? (
              <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>
                {link.label}
              </a>
            ) : (
              <span aria-disabled="true">[{link.label}]</span>
            ),
          )}
        </div>
      </div>
      <div class="placeholder-media portrait">真实人像 / 工作现场 / 个人作品图</div>
    </section>

    <section id="about" class="shell section">
      <h2>我在做什么</h2>
      <p>职业主轴是高性能图形、游戏引擎工具与跨平台系统。技术不是标签，而是我处理问题的方式。</p>
      <div class="about-grid">
        <article><h3>经历</h3><p>维护 C++ 商业代码，接触 PDF 页面对象、图片编解码、数据路径与故障处理。</p></article>
        <article><h3>关注</h3><p>资源如何进入渲染管线，平台差异如何被隔离，性能问题如何留下证据。</p></article>
        <article><h3>做事方式</h3><p>从现象到最小复现，再用测试、分析和文档把修复变成可复用经验。</p></article>
      </div>
    </section>

    <section id="projects" class="section work-section">
      <div class="shell">
        <p class="pixel-type">WORK DECK</p>
        <h2>作品会增长，牌组不封顶。</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <p class="pixel-type">{project.kind}</p>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <div class="placeholder-media">{project.mediaLabel}</div>
              <p>{project.technologies.join(" / ")}</p>
              <strong>{project.status}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="articles" class="shell section">
      <h2>代表文章</h2>
      <p>只展示来自真实项目、调试、性能分析和架构决策的文章。</p>
      <div class="article-list">
        {articles.map((article) => (
          <article>
            <div>
              <h3>[文章占位] {article.title}</h3>
              <p>{article.topic}</p>
            </div>
            <span>{article.status}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="life" class="shell section">
      <h2>屏幕之外</h2>
      <p>像素世界、探索、科幻、动画、绘画与影像，是生活里的观察方式，不是另一份职业项目。</p>
      <div class="life-grid">
        <div class="placeholder-media">真实照片占位 / 日常观察</div>
        <div class="placeholder-media">真实照片占位 / 绘画与影像</div>
        <div class="placeholder-media">真实照片占位 / 游戏与旅行</div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="shell">
        <h2>来聊聊图形、工具和下一段工作。</h2>
        <p>简历、GitHub 和邮箱将在提供真实地址后上线。</p>
        <a class="button contact-button" href={site.blog} target="_blank" rel="noreferrer">先看博客</a>
        <div class="contact-links">
          {primaryLinks.map((link) => link.href ? <a href={link.href}>{link.label}</a> : <span>[{link.label}]</span>)}
        </div>
        <footer>
          <strong>{site.title}</strong>
          <span>{site.domain}</span>
        </footer>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-top: 8px solid var(--accent);
    background: rgb(var(--page-rgb) / 0.9);
    backdrop-filter: blur(14px);
  }
  .nav {
    min-height: var(--nav-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .identity { font-weight: 800; text-decoration: none; }
  .nav-links { display: flex; gap: 26px; }
  .nav-links a { font-weight: 700; text-decoration: none; }
  .nav > :last-child { justify-self: end; }
  .hero {
    min-height: calc(100dvh - var(--nav-height));
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 70px;
    align-items: center;
    padding-block: 56px 70px;
  }
  .direction { color: var(--accent-strong); font-weight: 800; }
  h1, h2, h3 { margin: 0; font-family: var(--font-display); letter-spacing: 0; line-height: 1.15; }
  h1 { max-width: 760px; font-size: clamp(3rem, 6vw, 5.5rem); }
  h2 { font-size: clamp(2.2rem, 4.5vw, 4rem); }
  h3 { font-size: 1.35rem; }
  .intro { max-width: 620px; margin-block: 28px; font-size: clamp(1.08rem, 2vw, 1.35rem); font-weight: 650; }
  .actions { display: flex; gap: 16px; margin-block: 32px; }
  .button { min-width: 156px; padding: 14px 24px; border: 1px solid var(--ink); border-radius: var(--radius-control); font-weight: 800; text-align: center; text-decoration: none; }
  .button:active { transform: scale(0.98); }
  .primary, .contact-button { background: var(--ink); color: var(--page); }
  .secondary { background: transparent; }
  .quick-links { display: flex; flex-wrap: wrap; gap: 24px; color: var(--muted); font-weight: 700; }
  .portrait { min-height: 610px; }
  .section { padding-block: 110px; }
  .section > p { max-width: 720px; font-size: 1.12rem; color: var(--muted); }
  .about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 54px; margin-top: 62px; }
  .about-grid article { border-top: 5px solid var(--accent); padding-top: 26px; }
  .about-grid p { color: var(--muted); }
  .work-section { border-top: 8px solid var(--accent); background: var(--surface); padding-block: 110px; }
  .work-section h2 { max-width: 820px; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 62px; }
  .project-card { display: grid; gap: 18px; min-height: 560px; padding: 28px; border: 1px solid var(--line-strong); border-top: 4px solid var(--accent); border-radius: var(--radius-panel); background: var(--surface); box-shadow: 14px 14px 0 var(--surface-strong); }
  .project-card .placeholder-media { min-height: 260px; }
  .article-list { margin-top: 54px; }
  .article-list article { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 28px; padding-block: 28px; border-bottom: 1px solid var(--line); }
  .article-list p { color: var(--muted); }
  .life-grid { display: grid; grid-template-columns: 0.9fr 0.9fr 1.1fr; gap: 24px; margin-top: 50px; }
  .life-grid > :nth-child(2) { transform: translateY(-18px); background: var(--surface-muted); }
  .contact-section { padding-block: 100px 36px; background: var(--accent); color: var(--accent-ink); }
  .contact-section h2 { max-width: 880px; }
  .contact-button { display: inline-block; margin-block: 24px; background: var(--accent-ink); color: var(--accent); }
  .contact-links { display: flex; flex-wrap: wrap; gap: 32px; padding-block: 20px 70px; font-family: var(--font-pixel); font-size: 0.63rem; }
  footer { display: flex; justify-content: space-between; padding-top: 28px; border-top: 1px solid rgb(7 17 26 / 0.25); }
  @media (max-width: 767px) {
    .nav { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
    .hero { min-height: auto; grid-template-columns: 1fr; gap: 30px; padding-block: 38px 70px; }
    .direction { max-width: 300px; }
    h1 { font-size: clamp(2.75rem, 15vw, 4rem); }
    .actions { display: grid; grid-template-columns: 1fr 1fr; }
    .button { min-width: 0; padding-inline: 12px; }
    .portrait { min-height: 350px; order: 2; }
    .section, .work-section { padding-block: 80px; }
    .about-grid, .project-grid { grid-template-columns: 1fr; }
    .about-grid { gap: 40px; }
    .project-card { min-height: auto; box-shadow: 8px 8px 0 var(--surface-strong); }
    .article-list article { grid-template-columns: 1fr auto; }
    .life-grid { grid-template-columns: 1fr 0.28fr 0.28fr; overflow: hidden; }
    .life-grid .placeholder-media { min-width: 260px; }
    .contact-links { display: grid; gap: 0; padding-bottom: 86px; }
    .contact-links > * { padding-block: 18px; border-bottom: 1px solid rgb(7 17 26 / 0.18); }
  }
</style>
